# Docker Compose interpolation
ENV_FILE=.env
IMAGE_TAG=local
MODEL_VOLUME_PATH=./Models_New

# Application configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
RQ_JOB_TIMEOUT=1800

# Data services
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-server-side-secret-key
REDIS_URL=redis://redis:6379/0

# Model path inside the API/worker containers
MODEL_ROOT=/models
